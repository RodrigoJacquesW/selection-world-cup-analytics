config {
  type: "table",
  name: "stg_match_stats"
}

SELECT
    CAST(event_id AS INT64) AS event_id,
    team,
    home_team,
    away_team,
    SAFE_CAST(REPLACE(`Ball possession_home`, '%', '') AS INT64) AS ball_possession_home,
    SAFE_CAST(REPLACE(`Ball possession_away`, '%', '') AS INT64) AS ball_possession_away,
    SAFE_CAST(`Big chances_home` AS INT64) AS big_chances_home,
    SAFE_CAST(`Big chances_away` AS INT64) AS big_chances_away,
    SAFE_CAST(`Big chances scored_home` AS INT64) AS big_chances_scored_home,
    SAFE_CAST(`Big chances scored_away` AS INT64) AS big_chances_scored_away,
    SAFE_CAST(`Big chances missed_home` AS INT64) AS big_chances_missed_home,
    SAFE_CAST(`Big chances missed_away` AS INT64) AS big_chances_missed_away,
    SAFE_CAST(`Total shots_home` AS INT64) AS total_shots_home,
    SAFE_CAST(`Total shots_away` AS INT64) AS total_shots_away,
    SAFE_CAST(`Shots on target_home` AS INT64) AS shots_on_target_home,
    SAFE_CAST(`Shots on target_away` AS INT64) AS shots_on_target_away,
    SAFE_CAST(`Shots off target_home` AS INT64) AS shots_off_target_home,
    SAFE_CAST(`Shots off target_away` AS INT64) AS shots_off_target_away,
    SAFE_CAST(`Blocked shots_home` AS INT64) AS blocked_shots_home,
    SAFE_CAST(`Blocked shots_away` AS INT64) AS blocked_shots_away,
    SAFE_CAST(`Shots inside box_home` AS INT64) AS shots_inside_box_home,
    SAFE_CAST(`Shots inside box_away` AS INT64) AS shots_inside_box_away,
    SAFE_CAST(`Shots outside box_home` AS INT64) AS shots_outside_box_home,
    SAFE_CAST(`Shots outside box_away` AS INT64) AS shots_outside_box_away,
    SAFE_CAST(`Hit woodwork_home` AS INT64) AS hit_woodwork_home,
    SAFE_CAST(`Hit woodwork_away` AS INT64) AS hit_woodwork_away,
    SAFE_CAST(`Goalkeeper saves_home` AS INT64) AS goalkeeper_saves_home,
    SAFE_CAST(`Goalkeeper saves_away` AS INT64) AS goalkeeper_saves_away,
    SAFE_CAST(`Corner kicks_home` AS INT64) AS corner_kicks_home,
    SAFE_CAST(`Corner kicks_away` AS INT64) AS corner_kicks_away,
    SAFE_CAST(`Free kicks_home` AS INT64) AS free_kicks_home,
    SAFE_CAST(`Free kicks_away` AS INT64) AS free_kicks_away,
    SAFE_CAST(`Fouls_home` AS INT64) AS fouls_home,
    SAFE_CAST(`Fouls_away` AS INT64) AS fouls_away,
    SAFE_CAST(`Yellow cards_home` AS INT64) AS yellow_cards_home,
    SAFE_CAST(`Yellow cards_away` AS INT64) AS yellow_cards_away,
    SAFE_CAST(`Offsides_home` AS INT64) AS offsides_home,
    SAFE_CAST(`Offsides_away` AS INT64) AS offsides_away,
    SAFE_CAST(`Passes_home` AS INT64) AS passes_home,
    SAFE_CAST(`Passes_away` AS INT64) AS passes_away,
    SAFE_CAST(`Accurate passes_home` AS INT64) AS accurate_passes_home,
    SAFE_CAST(`Accurate passes_away` AS INT64) AS accurate_passes_away,
    SAFE_CAST(`Long balls_home` AS INT64) AS long_balls_home,
    SAFE_CAST(`Long balls_away` AS INT64) AS long_balls_away,
    SAFE_CAST(`Tackles_home` AS INT64) AS tackles_home,
    SAFE_CAST(`Tackles_away` AS INT64) AS tackles_away,
    SAFE_CAST(`Throw-ins_home` AS INT64) AS throw_ins_home,
    SAFE_CAST(`Throw-ins_away` AS INT64) AS throw_ins_away,
    SAFE_CAST(`Final third entries_home` AS INT64) AS final_third_entries_home,
    SAFE_CAST(`Final third entries_away` AS INT64) AS final_third_entries_away,
    SAFE_CAST(`Fouled in final third_home` AS INT64) AS fouled_in_final_third_home,
    SAFE_CAST(`Fouled in final third_away` AS INT64) AS fouled_in_final_third_away
FROM
  `project-be319738-ee9e-43d7-ada.selections.match_stats`